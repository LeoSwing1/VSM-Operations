# =============================================================================
# VSM Growth Operations — environment
# Copy to .env.local for local dev; add the same keys in Vercel → Settings → Environment Variables.
# NEVER commit real values. Never prefix a secret with NEXT_PUBLIC_.
# =============================================================================

# --- Supabase (Project Settings → API) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS. Used ONLY by: public enquiry intake, email worker, user invites.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email -------------------------------------------------------------------
# brevo (recommended) or resend. If unset: brevo when BREVO_API_KEY exists, else resend.
EMAIL_PROVIDER=brevo
# Brevo → SMTP & API → API keys → "Generate a new API key" (v3, starts with xkeysib-)
BREVO_API_KEY=
# Only needed if EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Must be a sender/domain verified in Brevo (Senders, Domains & Dedicated IPs)
EMAIL_FROM="VSM Growth <ops@vsmgrowth.com>"
EMAIL_REPLY_TO=hello@vsmgrowth.com
# Where "new website enquiry" alerts go
ALERT_EMAIL=

# --- Public website → CRM ----------------------------------------------------
ORG_SLUG=vsm-growth
# Random 32+ chars; only needed for server-to-server posts (header X-Intake-Key)
ENQUIRY_INTAKE_KEY=
ENQUIRY_ALLOWED_ORIGINS=https://vsmgrowth.com,https://www.vsmgrowth.com

# --- Cron (Vercel sends Authorization: Bearer <CRON_SECRET>) ------------------
CRON_SECRET=

APP_URL=https://ops.vsmgrowth.com
APP_TIMEZONE=Asia/Kolkata

# --- Google / Microsoft calendar sync ----------------------------------------
# OAuth redirect URIs: {APP_URL}/api/integrations/calendar/google/callback
# and {APP_URL}/api/integrations/calendar/microsoft/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
# Generate 32 random bytes; store as 64 hex characters or base64. Server-only.
CALENDAR_TOKEN_ENCRYPTION_KEY=

# ---------- Block 17 · delivery channels (all server-only unless NEXT_PUBLIC_) ----------
# WhatsApp Cloud API (Meta Business → WhatsApp → API setup). Use a permanent System User token.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Approved template with 2 body variables: {{1}} title, {{2}} link
WHATSAPP_TEMPLATE=vsm_notification
WHATSAPP_TEMPLATE_LANG=en
# Web push — generate once with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@vsmgrowth.com
# Slack incoming webhook / Teams Workflows webhook URL (company events only)
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# ---------- Block 17 · inbound webhooks ----------
# Meta Lead Ads + WhatsApp statuses → https://<APP_URL>/api/webhooks/meta
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_TOKEN=
# Razorpay → https://<APP_URL>/api/webhooks/razorpay (Dashboard → Webhooks → secret)
RAZORPAY_WEBHOOK_SECRET=

# ---------- Block 17 · product analytics (optional, anonymous) ----------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ---------- Block 18 ----------
# Email domain used for the 5 demo logins (they are never sent mail; logins are shown once in the Super Admin console)
DEMO_EMAIL_DOMAIN=demo.vsmgrowth.com

# ---------- Blocks 19–23 ----------
# Google Workspace (one OAuth client for Calendar + Drive + Gmail). Redirect URI: https://<APP_URL>/api/integrations/calendar/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64 — encrypts Google tokens at rest:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CALENDAR_TOKEN_ENCRYPTION_KEY=
# Set to gmail to send all company emails through the connected Gmail account (Settings → Integrations → Google)
# EMAIL_PROVIDER=gmail
# End-to-end tests (staging only — never production credentials)
# E2E_EMAIL=
# E2E_PASSWORD=

# ---------- Blocks 25–27 ----------
# AI assistant (Claude API). Server-only — never prefix with NEXT_PUBLIC_. Switch it on in Settings → AI assistant.
ANTHROPIC_API_KEY=
